---
import ResetPasswordForm from '@/components/islands/ResetPasswordForm';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Nueva contraseña" solidHeader>
  <section class="mx-auto flex max-w-md flex-col gap-6 px-4 pb-24 pt-36 md:px-8">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-semibold text-balance md:text-h2">Crea tu nueva contraseña</h1>
      <p class="text-body text-text-muted">Elige una contraseña que no uses en otros sitios.</p>
    </div>
    <ResetPasswordForm client:load />
  </section>
</BaseLayout>
