---
import Complements from '@/components/sections/Complements.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import Faq from '@/components/sections/Faq.astro';
import Hero from '@/components/sections/Hero.astro';
import MostRequestedSpaces from '@/components/sections/MostRequestedSpaces.astro';
import SpaceTypes from '@/components/sections/SpaceTypes.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: new URL('/', Astro.site).href,
  logo: new URL('/favicon.ico', Astro.site).href,
  telephone: `+${SITE.whatsappNumber}`,
};
---

<BaseLayout whatsappFab jsonLd={jsonLd}>
  <Hero />
  <div class="reveal">
    <SpaceTypes />
    <MostRequestedSpaces />
    <Complements />
    <Faq />
    <CtaBanner />
  </div>
</BaseLayout>

<script>
  // Cada elemento aparece al entrar en pantalla. Sin JS o con "reducir movimiento", se ve todo.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = document.querySelectorAll<HTMLElement>(
      '.reveal h2:not([data-animate] h2), .reveal h2 + p, .reveal li, .reveal details, .reveal [data-animate]',
    );
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    for (const item of items) {
      // Escalonado entre hermanos (tarjetas de una misma fila).
      const index = Array.from(item.parentElement?.children ?? []).indexOf(item);
      item.style.setProperty('--delay', `${Math.min(index, 3) * 120}ms`);
      item.classList.add('will-reveal');
      observer.observe(item);
    }
  }
</script>
