---
import AuthCallback from '@/components/islands/AuthCallback';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Confirmando cuenta" solidHeader noindex>
  <section class="mx-auto flex max-w-md flex-col gap-6 px-4 pb-24 pt-36 md:px-8">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-semibold text-balance md:text-h2">Confirmando tu cuenta</h1>
      <p class="text-body text-text-muted">Un momento, te llevamos al sitio.</p>
    </div>
    <AuthCallback client:load />
  </section>
</BaseLayout>
