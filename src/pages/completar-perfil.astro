---
import CompleteProfileForm from '@/components/islands/CompleteProfileForm';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Completar perfil" solidHeader>
  <section class="mx-auto flex max-w-md flex-col gap-6 px-4 pb-24 pt-36 md:px-8">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-semibold text-balance md:text-h2">Falta tu celular</h1>
      <p class="text-body text-text-muted">Lo necesitamos para contactarte por tu reserva.</p>
    </div>
    <CompleteProfileForm client:load />
  </section>
</BaseLayout>
