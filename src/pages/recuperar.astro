---
import ForgotPasswordForm from '@/components/islands/ForgotPasswordForm';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Recuperar contraseña" solidHeader noindex>
  <section class="mx-auto flex max-w-md flex-col gap-6 px-4 pb-24 pt-36 md:px-8">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-semibold text-balance md:text-h2">Recupera tu contraseña</h1>
      <p class="text-body text-text-muted">Te enviamos un enlace por correo.</p>
    </div>
    <ForgotPasswordForm client:load />
    <a href="/login" class="text-small font-semibold underline">Volver a iniciar sesión</a>
  </section>
</BaseLayout>
