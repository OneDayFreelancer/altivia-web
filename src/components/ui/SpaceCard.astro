---
import { Picture } from 'astro:assets';
import { PRICE_UNIT_LABEL } from '@/data/catalog';
import { type Space, spaceHref } from '@/data/spaces';
import { formatPrice } from '@/lib/spaceFilter';

interface Props {
  space: Space;
  /** Tamaño de imagen a pedir según el hueco del bento. */
  sizes: string;
  class?: string;
}

const { space, sizes, class: className } = Astro.props;
const { name, images, priceFrom, priceUnit, maxCapacity } = space.data;
const cover = images[0];
const unit = PRICE_UNIT_LABEL[priceUnit];
---

<a
  href={spaceHref(space)}
  class:list={['group relative block h-full min-h-40', className]}
>
  <div class="absolute inset-0 overflow-clip bg-surface-alt">
    <Picture
      src={cover.src}
      alt={cover.alt}
      widths={[480, 768, 1200]}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading="lazy"
      pictureAttributes={{ class: 'parallax block h-full w-full' }}
      class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 group-hover:scale-105 group-focus-visible:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="absolute inset-x-0 bottom-0 flex flex-col gap-1 p-5 text-white">
    <h3 class="text-h4 font-semibold">{name}</h3>
    <p class="flex flex-wrap items-center gap-x-3 text-small">
      <span>Desde <span class="font-semibold">{formatPrice(priceFrom)}</span> / {unit}</span>
      <span class="inline-flex items-center gap-1" title={`Capacidad máxima: ${maxCapacity} personas`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        <span class="sr-only">Capacidad máxima:</span>{maxCapacity}
      </span>
    </p>
  </div>
</a>
